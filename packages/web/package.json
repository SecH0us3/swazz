{
    "name": "@swazz/web",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "sync-docs": "node -e \"const fs = require('fs'); fs.copyFileSync('../../docs/ai.txt', 'public/ai.txt'); fs.copyFileSync('../../docs/llms.txt', 'public/llms.txt'); fs.copyFileSync('../../docs/llms-full.txt', 'public/llms-full.txt');\"",
        "predev": "npm run sync-docs && node ../extension/build-zip.mjs --mode dev --out public/swazz-extension.zip",
        "prebuild": "npm run sync-docs && node ../extension/build-zip.mjs --mode prod --out public/swazz-extension.zip",
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "deploy": "npm run build && wrangler deploy",
        "test": "vitest run"
    },
    "dependencies": {
        "@simplewebauthn/browser": "^14.0.0",
        "@swazz/shared": "*",
        "qrcode": "^1.5.4",
        "react": "^19.2.8",
        "react-dom": "^19.3.0",
        "react-virtuoso": "^4.18.13",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.3",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^5.0.2",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "^30.0.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.2"
    }
}
