{
  "name": "swazz",
  "version": "1.0.0",
  "private": true,
  "description": "Smart API Fuzzer — find crashes before your users do",
  "workspaces": [
    "packages/web",
    "packages/edge",
    "packages/rag",
    "packages/shared",
    "packages/extension",
    "demo",
    "docs"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=packages/edge",
    "dev:frontend": "npm run dev --workspace=packages/web",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspace=packages/web",
    "deploy:api": "npm run deploy --workspace=packages/edge",
    "deploy:web": "npm run deploy --workspace=packages/web",
    "deploy:demo": "npm run deploy --workspace=demo",
    "deploy:all": "npm run deploy:web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.3",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "undici": "7.29.1",
    "lodash-es": "4.18.1",
    "sharp": "0.35.5",
    "adm-zip": "0.6.1",
    "launch-editor": "2.14.1",
    "vite": "^8.2.1",
    "dompurify": "3.4.16",
    "vue": "^3.5.42",
    "@vue/server-renderer": "^3.5.42",
    "katex": "^0.18.2",
    "shell-quote": "^1.11.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true,
    "sharp@0.35.5": true,
    "workerd@1.20260813.1": true
  }
}
